# Canonical site origin for sitemap, robots, Open Graph, and JSON-LD (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.vishvaprojects.in

# Optional Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty locally or in CI to keep analytics completely disabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Google Search Console HTML meta verification token (the content="..." value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

